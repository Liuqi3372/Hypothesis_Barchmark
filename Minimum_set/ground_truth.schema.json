{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Minimum Fact Ground Truth",
  "type": "object",
  "required": [
    "schema_version", "generated_at_utc", "status", "target_paper",
    "ground_truth", "fact_subset_optimization", "minimum_reference_set",
    "two_level_deletion_validation", "audit"
  ],
  "properties": {
    "schema_version": {"const": "minimum-fact-bridge-ground-truth-2.0"},
    "status": {"const": "COMPLETE"},
    "ground_truth": {
      "type": "object",
      "required": ["known_facts", "knowledge_gap", "hypothesis", "bridge_relations", "gap_hypothesis_pairs"],
      "properties": {
        "known_facts": {"type": "array", "minItems": 2, "maxItems": 6},
        "knowledge_gap": {"type": "string", "minLength": 1},
        "hypothesis": {"type": "string", "minLength": 1},
        "bridge_relations": {"type": "array", "minItems": 1},
        "gap_hypothesis_pairs": {"type": "array", "minItems": 2, "maxItems": 6}
      }
    },
    "fact_subset_optimization": {
      "type": "object",
      "required": ["objective", "candidate_fact_count", "evaluated_subset_count", "all_subset_assessments", "selected_subset"]
    },
    "minimum_reference_set": {
      "type": "object",
      "required": ["objective", "selected_reference_count", "selected_references"]
    },
    "two_level_deletion_validation": {
      "type": "object",
      "required": ["fact_deletion", "reference_deletion", "all_selected_facts_indispensable", "all_selected_references_indispensable"]
    }
  }
}
